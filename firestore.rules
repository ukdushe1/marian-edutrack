rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ───────────────────────────────────────────────────────────
    function isSignedIn()       { return request.auth != null; }
    function uid()              { return request.auth.uid; }
    function claims()           { return request.auth.token; }
    // Roles come from custom claims when set (by Admin SDK / Cloud Functions);
    // otherwise from users/{uid}.roles, which only the Principal / System Admin can write.
    function userDocPath()      { return /databases/$(database)/documents/users/$(uid()); }
    function roles() {
      return claims().get('roles', null) != null ? claims().roles
           : exists(userDocPath()) ? get(userDocPath()).data.get('roles', [])
           : [];
    }
    function hasRole(r)         { return isSignedIn() && r in roles(); }
    // Role names (see src/lib/roles.js). Legacy aliases still accepted:
    //   head  = vicePrincipal (old "Head / Deputy")   tutor = classTeacher (old "Form Tutor")
    // The Principal has full administrator rights.
    function isAdmin()          { return hasRole('superAdmin') || hasRole('principal'); }
    function isSenior()         { return isAdmin() || hasRole('vicePrincipal') || hasRole('head'); }
    function isHead()           { return isSenior(); }   // report approval / publishing
    function isHOD()            { return isSenior() || hasRole('hod'); }
    function isExams()          { return isSenior() || hasRole('examsOfficer'); }
    function isBoarding()       { return isSenior() || hasRole('boardingMaster'); }
    function isStaff()          { return isHOD() || hasRole('teacher') || hasRole('classTeacher') || hasRole('tutor')
                                    || hasRole('examsOfficer') || hasRole('boardingMaster'); }
    // Subjects (syllabus codes) a HOD is responsible for, from their user profile
    function hodSubjects()      { return exists(userDocPath()) ? get(userDocPath()).data.get('hodSubjects', []) : []; }
    function hodOf(code)        { return hasRole('hod') && code in hodSubjects(); }
    function same(field)        { return request.resource.data.get(field, null) == resource.data.get(field, null); }
    function onlyChanges(keys)  { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ── users ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isSignedIn() && (uid() == userId || isStaff());
      // First sign-in: a person may create their own profile, but with no roles
      allow create: if isAdmin() || (isSignedIn() && uid() == userId
                      && request.resource.data.get('roles', []).size() == 0
                      && !('hodSubjects' in request.resource.data));
      // Roles and HOD subjects are assigned only by the Principal / System Admin
      allow update, delete: if isAdmin();
    }

    // ── syllabi: all staff read; HOD of that subject or Principal/Admin write ─
    match /syllabi/{id} {
      allow read:   if isStaff();
      allow create: if isAdmin() || hodOf(request.resource.data.code);
      allow update: if isAdmin() || (hodOf(resource.data.code) && hodOf(request.resource.data.code));
      allow delete: if isAdmin() || hodOf(resource.data.code);
    }

    // ── comment bank: all staff read; HOD (own subjects or general) and seniors write ─
    match /commentBank/{id} {
      allow read:   if isStaff();
      allow create: if isSenior() || (hasRole('hod') &&
                      (request.resource.data.subject == '' || hodOf(request.resource.data.subject)));
      allow update: if isSenior() || (hasRole('hod') &&
                      (resource.data.subject == '' || hodOf(resource.data.subject)) &&
                      (request.resource.data.subject == '' || hodOf(request.resource.data.subject)));
      allow delete: if isAdmin();
    }
    match /gradeBoundaries/{id} { allow read: if isStaff(); allow write: if isExams(); }
    match /gradingScales/{id}   { allow read: if isStaff(); allow write: if isAdmin(); }

    // ── school structure ──────────────────────────────────────────────────
    match /classes/{id}  { allow read: if isStaff(); allow write: if isAdmin(); }
    match /students/{id} { allow read: if isStaff(); allow write: if isAdmin() || isHOD(); }
    match /terms/{id}    { allow read: if isStaff(); allow write: if isAdmin(); }

    // ── teaching groups ───────────────────────────────────────────────────
    match /teachingGroups/{groupId} {
      allow read: if isStaff();
      allow write: if isAdmin();

      // Schemes of work: group teachers or HOD/admin
      match /schemeEntries/{eId} {
        allow read:  if isStaff();
        allow write: if isHOD() ||
          (isStaff() && uid() in get(/databases/$(database)/documents/teachingGroups/$(groupId)).data.teacherIds);
      }

      // Assessments: the class's teachers or HOD/admin. Only HOD+ change lock/moderation;
      // once frozen (published exam results) only the Principal / VP can change them.
      function teachesGroup() { return uid() in get(/databases/$(database)/documents/teachingGroups/$(groupId)).data.get('teacherIds', []); }
      match /assessments/{aId} {
        allow read: if isStaff();
        allow create: if isStaff() && (isHOD() || teachesGroup());
        allow update: if isStaff() && (isHOD() || teachesGroup())
                      && (!resource.data.get('frozen', false) || isHead())
                      && (isHOD() || (same('locked') && same('moderation') && same('frozen')));
        allow delete: if isAdmin() || ((isHOD() || teachesGroup()) && !resource.data.get('frozen', false));

        // Marks: the class's teachers + HOD/admin; blocked when the assessment is
        // locked (HOD+ only) or frozen (Principal / VP only).
        function assessmentPath() { return /databases/$(database)/documents/teachingGroups/$(groupId)/assessments/$(aId); }
        match /marks/{mId} {
          allow read: if isStaff();
          allow write: if isStaff() &&
            (!('locked' in request.resource.data) || isHOD()) &&
            (isHOD() || teachesGroup()) &&
            (!exists(assessmentPath()) || (
              (!get(assessmentPath()).data.get('locked', false) || isHOD()) &&
              (!get(assessmentPath()).data.get('frozen', false) || isHead())));
        }
      }
    }

    // ── registers ─────────────────────────────────────────────────────────
    match /registers/{id} {
      allow read:  if isStaff();
      allow write: if isStaff();
    }

    // ── reports ───────────────────────────────────────────────────────────
    match /reports/{id} {
      allow read: if isStaff() || (isSignedIn() && hasRole('parent') &&
        resource.data.status == 'published' && resource.data.guardianIds.hasAny([uid()]));
      allow create: if isHead() || (isStaff() && !(request.resource.data.status in ['approved', 'published']));
      // Staff edit drafts and reviewed reports; only Principal / Vice Principal
      // approve, publish, or touch an approved/published report.
      allow update: if isHead() || (isStaff()
                      && !(resource.data.status in ['approved', 'published'])
                      && !(request.resource.data.status in ['approved', 'published']));
      allow delete: if isAdmin();
    }

    // ── conduct ───────────────────────────────────────────────────────────
    match /conduct/{id} {
      allow read:  if isStaff();
      allow create: if isStaff();
      allow update: if isAdmin();
    }

    // ── audit log — append-only ───────────────────────────────────────────
    match /auditLog/{id} {
      allow read:   if isAdmin();
      allow create: if isStaff() && request.resource.data.who == uid();
      allow update, delete: if false;
    }

    // ── guardians — contact details; staff read, admin write ──────────────
    match /guardians/{id} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }

    // ── message log — append-only audit of guardian messages ──────────────
    // Cloud Functions write via Admin SDK; staff may log click-to-send links they open.
    match /messageLog/{id} {
      allow read:   if isHead();
      allow create: if isStaff()
        && request.resource.data.sentBy == uid()
        && request.resource.data.channel == 'whatsapp-link'
        && request.resource.data.status == 'opened';
      allow update, delete: if false;
    }

    // ── resources & bookings ──────────────────────────────────────────────
    match /resources/{id} {
      allow read:  if isStaff();
      allow write: if isHOD();
    }
    match /resourceBookings/{id} {
      allow read:   if isStaff();
      allow create: if isStaff() && request.resource.data.bookedBy == uid();
      allow update, delete: if isStaff() && (resource.data.bookedBy == uid() || isHOD());
    }

    // ── notices — HOD/head post; any staff may mark as read ───────────────
    match /notices/{id} {
      allow read:   if isStaff();
      allow create: if isHOD();
      allow update: if isHOD() || (isStaff() && onlyChanges(['readBy']));
      allow delete: if isHOD();
    }

    // ── cover & relief ────────────────────────────────────────────────────
    match /coverRequests/{id} {
      allow read, write: if isStaff();
    }

    // ── predictions (one doc per teaching group) ──────────────────────────
    match /predictions/{id} {
      allow read, write: if isStaff();
    }

    // ── settings (e.g. settings/backup: last backup time) ─────────────────
    match /settings/{id} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }

    // ── end-of-term exam module ───────────────────────────────────────────
    match /examWindows/{id} {
      allow read:   if isStaff();
      allow create: if isExams();
      // Exams officer runs the window; approving and publishing are Principal / VP only
      allow update: if isHead() || (isExams() && same('approved') && same('published') && same('version'));
      allow delete: if isAdmin();
    }
    match /examPapers/{id} {
      allow read:   if isStaff();
      allow create: if isExams() || hodOf(request.resource.data.syllabusCode);
      allow update: if
        // HOD of the subject (vets) or Principal / VP: anything
        isSenior() || hodOf(resource.data.syllabusCode)
        // Exams officer: timetable, printing — but not vetting
        || (hasRole('examsOfficer') && (same('status') || request.resource.data.status == 'printed'))
        // Setter: only their own draft, and it stays a draft
        || (resource.data.get('setterId', '') == uid() && resource.data.status == 'draft'
            && request.resource.data.status == 'draft' && same('setterId'))
        // Invigilator: attendance sign-off and incidents only
        || (isStaff() && uid() in resource.data.get('invigilatorIds', [])
            && onlyChanges(['attendanceSubmitted', 'attendanceBy', 'incidents', 'updatedAt']));
      allow delete: if isAdmin() || ((isExams() || hodOf(resource.data.syllabusCode)) && resource.data.status == 'draft');
    }
    match /examSittings/{id} {
      allow read:   if isStaff();
      allow create, update: if isExams() || (isStaff() && uid() in
        get(/databases/$(database)/documents/examPapers/$(request.resource.data.paperId)).data.get('invigilatorIds', []));
      allow delete: if isExams();
    }
    // Saved once at publication; parents will read their own child's in phase 2
    match /resultSnapshots/{id} {
      allow read:  if isStaff();
      allow write: if isHead();
    }

    // ── exams ─────────────────────────────────────────────────────────────
    match /examSessions/{id}     { allow read: if isStaff(); allow write: if isExams(); }
    match /cambridgeEntries/{id} { allow read: if isStaff(); allow write: if isExams(); }

    // ── boarding ──────────────────────────────────────────────────────────
    match /exeats/{id}        { allow read: if isStaff();    allow write: if isBoarding(); }
    match /houseRollCall/{id} { allow read: if isStaff();    allow write: if isBoarding(); }
    // Medical — boarding staff and head only
    match /sickBay/{id}       { allow read, write: if isBoarding(); }
  }
}
